<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="header" style="padding-left: 6px; padding-right: 6px; padding-top: 10px; padding-bottom: 10px; background-color: rgb(43, 41, 43);">
        <ui:VisualElement name="info" style="flex-direction: row;">
            <ui:VisualElement name="flora-image" style="background-image: url(&apos;project://database/Packages/com.ma.flora.installer/Editor/Icons/Flora.png?fileID=2800000&amp;guid=d5d4dbd6291673f4f9934f110359022e&amp;type=3#Flora&apos;); min-width: 64px; min-height: 64px; margin-right: 10px;" />
            <ui:VisualElement name="info-container">
                <ui:Label text="Flora" display-tooltip-when-elided="true" name="title-label" style="font-size: 20px; -unity-font-style: bold; color: rgb(255, 255, 255);" />
                <ui:Label text="Version: 1.0.10" display-tooltip-when-elided="true" name="version-label" style="margin-top: 10px; -unity-font-style: normal;" />
                <ui:Label text="Installed: 1.0.10" display-tooltip-when-elided="true" name="installed-version-label" style="-unity-font-style: bold; margin-top: 5px;" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="buttons" style="flex-direction: row; margin-top: 10px;">
            <ui:Button text="Install" display-tooltip-when-elided="true" name="install-button" />
            <ui:Button text="Import Sample" display-tooltip-when-elided="true" name="install-demo-button" />
            <ui:Button text="Upgrade Unity Collections" display-tooltip-when-elided="true" name="upgrade-unity-collections-button" tooltip="It's recomended to upgrade to the latest Unity collections package." />
        </ui:VisualElement>
    </ui:VisualElement>
    <ui:ScrollView name="changelog-scrollview" style="flex-grow: 1;">
        <ui:Label display-tooltip-when-elided="true" name="changelog-text" style="white-space: normal;" />
    </ui:ScrollView>
</ui:UXML>
