
.instanced-property-view {
    width: 400px;
    min-height: 26px;
}

.instanced-property-view__content__property-list {
    margin-top: 2px;
    flex-shrink: 1;
}

/* Empty View */

.instanced-property-view__empty-view {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    flex-grow: 1;
}

.instanced-property-view__empty-view__icon {
    background-image: resource('UIPackageResources/Images/d_console.infoicon.png');
    margin: 4px;
    width: 16px;
    height: 16px;
}

.instanced-property-view__empty-view__text {
    margin-top: 4px;
    color: rgba(255, 255, 255, 0.5);
}

/* Item */

.instanced-property-view-item {
    flex-direction: row;
    align-items: center;
    height: 22px;
}

.instanced-property-view-item__active {
    margin-top: 2px;
    width: 16px;
}

.instanced-property-view-item__name {
    min-width: 120px;
    flex-grow: 1;
}

.instanced-property-view-item__type {
    min-width: 60px;
    flex-shrink: 1;
}

.instanced-property-view-item__value {
    min-width: 100px;
}
