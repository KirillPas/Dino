/* Header */

.instanced-prototype-view__header {
    flex-direction: row;
    justify-content: center;
    min-height: 20px;
}

.instanced-prototype-view__header__search-field {
    width: 120px;
    flex-grow: 1;
}

.instanced-prototype-view__header__add-button {
    background-image: resource('d_Toolbar Plus');
    width: 20px;
    height: 20px;
    opacity: 0.7;
    margin-left: 2px;
    margin-right: 2px;
}

.instanced-prototype-view__header__add-button:hover {
    opacity: 1.0;
}

/* Labels */

.instanced-prototype-view__label-container {
    flex-direction: row;
    min-height: 24px;
    padding: 2px 4px;
    margin-bottom: 2px;
}

.instanced-prototype-view__label-container .asset-label__content {
    color: black;
    background-color: rgb(120, 202, 182);
    flex-shrink: 1;
    border-radius: 8px;
    padding: 2px 6px;
    opacity: 0.5;
    margin: 2px;
}

.instanced-prototype-view__label-container .asset-label__content:hover {
    opacity: 1.0;
}

.instanced-prototype-view__label-container .asset-label__content:active {
    opacity: 1.0;
    border-color: rgb(251, 202, 76);
}

/* Empty View */

.instanced-prototype-view__empty-view {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    flex-grow: 1;
}

.instanced-prototype-view__empty-view__icon {
    background-image: resource('UIPackageResources/Images/d_console.infoicon.png');
    margin: 4px;
    width: 16px;
    height: 16px;
}

.instanced-prototype-view__empty-view__text {
    margin-top: 4px;
    color: rgba(255, 255, 255, 0.5);
}

/* Grid */

.instanced-prototype-view__grid-view {
    flex-grow: 1;
}

/* Grid Item */

.instanced-prototype-grid-item {
}

.instanced-prototype-grid-item__content {
    border-color: rgb(10, 10, 10);
    border-width: 1px;
    opacity: 0.75;
}

.instanced-prototype-grid-item__content__thumbnail {
    min-width: 32px;
    min-height: 32px;
}

.instanced-prototype-grid-item__content__active-toggle {
    position: absolute;
    margin-top: 2px;
}

.instanced-prototype-grid-item:hover .instanced-prototype-grid-item__content {
    border-color: rgb(255, 255, 255);
    opacity: 0.75;
}

.instanced-prototype-grid-item.grid-view-items__selected .instanced-prototype-grid-item__content {
    border-color: rgb(0, 224, 255);
    opacity: 0.9;
}

.instanced-prototype-grid-item:active > .instanced-prototype-grid-item__content {
    border-color: rgb(251, 202, 76);
    opacity: 1.0;
}

.instanced-prototype-grid-item:hover:active > .instanced-prototype-grid-item__content {
    border-color: rgb(255, 255, 255);
    opacity: 1.0;
}

.instanced-prototype-grid-item.grid-view-items__selected:active > .instanced-prototype-grid-item__content {
    border-color: rgb(255, 255, 255);
    opacity: 1.0;
}

/* Footer */

.instanced-prototype-view__footer {
    flex-direction: row;
    min-height: 20px;
    margin-top: 2px;
    align-items: center;
    justify-content: flex-end;
}

.instanced-prototype-view__footer__item-size-slider {
    width: 120px;
}

.instanced-prototype-view__footer__resize-button {
    background-image: url('/Packages/com.ma.flora/Editor/EditorResources/Icon/d_Grip Icon.png');
    width: 16px;
    height: 16px;
    margin-top: 4px;
    margin-left: 4px;
    opacity: 0.8;
}

.instanced-prototype-view__footer__resize-button:active {
    background-image: url('/Packages/com.ma.flora/Editor/EditorResources/Icon/d_Grip On Icon.png');
}
