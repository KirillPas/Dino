// #pragma enable_d3d11_debug_symbols

#define THREADS_PER_GROUP (256)

#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"
#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Random.hlsl"

#include "Packages/com.ma.flora/ShaderLibrary/ComputeUtility.hlsl"
#include "Packages/com.ma.flora/ShaderLibrary/Quaternion.hlsl"

#define TRANSFORM_TEX(tex, name) ((tex.xy) * name##_ST.xy + name##_ST.zw)

struct LocalTransform
{
    float3 Position;
    float4 Rotation;
    float3 Scale;
};

AppendStructuredBuffer<LocalTransform> _TransformsBuffer;

SAMPLER(_LinearClampSampler);
SAMPLER(_PointClampSampler);

TEXTURE2D(_HeightMap);
float4 _HeightMap_TexelSize;
float4 _HeightMap_ST;

TEXTURE2D(_NormalMap);

float4 _CellMinMax;
float4 _TerrainPosition;
float4 _TerrainSize;

float4 _MinScale;          // w = scale mode
float4 _MaxScale;
float4 _MaskParams0;       // x = min slope angle, y = max slope angle, z = min height, w = max height
float4 _AlignmentParams0;  // x = align to surface flag, y = surface pitch angle range, z = random yaw range, w = random pitch range
float4 _AlignmentParams1;  // xy = vertical offset range

uint _HaltonBaseIndex;
uint _DesiredCount;

#define _ScaleMode              uint(_MinScale.w)
#define _SlopeMinMax            float2(_MaskParams0.xy)
#define _HeightMinMax           float2(_MaskParams0.zw)
#define _AlignToSurface         _AlignmentParams0.x
#define _AlignToSurfaceMaxAngle _AlignmentParams0.y
#define _RandomizeYaw           _AlignmentParams0.z
#define _RandomizePitchAngle    _AlignmentParams0.w
#define _VerticalOffsetMinMax   float2(_AlignmentParams1.xy)

// --- Placement ---

static const uint kScaleModeUniform = 0;
static const uint kScaleModeFree    = 1;
static const uint kScaleModeLockXY  = 2;
static const uint kScaleModeLockXZ  = 3;
static const uint kScaleModeLockYZ  = 4;

static const float3 kUp = float3(0, 1, 0);

float Halton(uint index, uint radix)
{
    float result = 0.0;
    float fraction = 1.0 / radix;

    while (index > 0)
    {
        result += (index % radix) * fraction;
        index /= radix;
        fraction /= radix;
    }

    return result;
}

bool IsHeightValid(float height)
{
    return height >= _HeightMinMax.x && height <= _HeightMinMax.y;
}

bool IsSlopeValid(float normalY, float tolerance = 0.0001)
{
    float minNormalAngle = cos(_SlopeMinMax.x);
    float maxNormalAngle = cos(_SlopeMinMax.y);
    return !(maxNormalAngle > (normalY + tolerance) || minNormalAngle < (normalY - tolerance));
}

bool IsWithinTerrainBounds(float3 position)
{
    float3 terrainMin = _TerrainPosition.xyz;
    float3 terrainMax = _TerrainPosition.xyz + _TerrainSize.xyz;
    return position.x >= terrainMin.x && position.x <= terrainMax.x &&
           position.y >= terrainMin.y && position.y <= terrainMax.y &&
           position.z >= terrainMin.z && position.z <= terrainMax.z;
}

bool IsValidPlacement(float3 position, float3 normal)
{
    return IsWithinTerrainBounds(position) && IsHeightValid(position.y) && IsSlopeValid(normal.y);
}

float4 ComputeRotation(float3 normal, int instanceID)
{
    float4 alignToSurfaceRot = kQuaternionIdentity;
    if (_AlignToSurface)
    {
        alignToSurfaceRot = QuaternionFromToRotation(kUp, normal);

        if (_AlignToSurfaceMaxAngle > 0.0)
        {
            float currentAngle = acos(dot(normal, kUp));
            if (currentAngle > _AlignToSurfaceMaxAngle)
            {
                float3 rotationAxis = normalize(cross(kUp, normal));
                alignToSurfaceRot = QuaternionFromAxisAngle(rotationAxis, _AlignToSurfaceMaxAngle);
            }
        }
    }

    float4 randomYawRot = kQuaternionIdentity;
    if (_RandomizeYaw)
    {
        float randomYaw = Halton(_HaltonBaseIndex + instanceID, 5) * TWO_PI;
        randomYawRot = QuaternionRotateY(randomYaw);
    }

    float4 randomPitchRot = kQuaternionIdentity;
    if (_RandomizePitchAngle)
    {
        float randomPitch = lerp(-_RandomizePitchAngle, _RandomizePitchAngle, Halton(_HaltonBaseIndex + instanceID, 7));
        randomPitchRot = QuaternionRotateX(randomPitch);
    }

    float4 finalRot = QuaternionMultiply(alignToSurfaceRot, QuaternionMultiply(randomYawRot, randomPitchRot));
    return finalRot;
}

float3 ComputeScale(int instanceID)
{
    float3 scale = 1.0;

    UNITY_BRANCH
    if (_ScaleMode == kScaleModeUniform)
    {
        scale = lerp(_MinScale.x, _MaxScale.x, Halton(_HaltonBaseIndex + instanceID, 11));
    }
    else if (_ScaleMode == kScaleModeFree)
    {
        scale = float3(lerp(_MinScale.x, _MaxScale.x, Halton(_HaltonBaseIndex + instanceID, 11)),
                       lerp(_MinScale.y, _MaxScale.y, Halton(_HaltonBaseIndex + instanceID, 13)),
                       lerp(_MinScale.z, _MaxScale.z, Halton(_HaltonBaseIndex + instanceID, 17)));
    }
    else if (_ScaleMode == kScaleModeLockXY)
    {
        scale.xy = lerp(_MinScale.x, _MaxScale.x, Halton(_HaltonBaseIndex + instanceID, 11));
        scale.z  = lerp(_MinScale.z, _MaxScale.z, Halton(_HaltonBaseIndex + instanceID, 13));
    }
    else if (_ScaleMode == kScaleModeLockXZ)
    {
        scale.xz = lerp(_MinScale.x, _MaxScale.x, Halton(_HaltonBaseIndex + instanceID, 11));
        scale.y  = lerp(_MinScale.y, _MaxScale.y, Halton(_HaltonBaseIndex + instanceID, 13));
    }
    else if (_ScaleMode == kScaleModeLockYZ)
    {
        scale.x  = lerp(_MinScale.x, _MaxScale.x, Halton(_HaltonBaseIndex + instanceID, 13));
        scale.yz = lerp(_MinScale.y, _MaxScale.y, Halton(_HaltonBaseIndex + instanceID, 11));
    }

    return scale;
}

// --- Samples ---

float3 CalculateNormal(float2 uv)
{
    uv = uv * _HeightMap_ST.xy + _HeightMap_ST.zw;

    float hL = _HeightMap.SampleLevel(_PointClampSampler, uv - float2(_HeightMap_TexelSize.x, 0), 0).r;
    float hR = _HeightMap.SampleLevel(_PointClampSampler, uv + float2(_HeightMap_TexelSize.x, 0), 0).r;
    float hD = _HeightMap.SampleLevel(_PointClampSampler, uv - float2(0, _HeightMap_TexelSize.y), 0).r;
    float hU = _HeightMap.SampleLevel(_PointClampSampler, uv + float2(0, _HeightMap_TexelSize.y), 0).r;

    float dx = (hR - hL) * 0.5;
    float dy = (hU - hD) * 0.5;

    float3 normal = normalize(float3(-dx, -dy, 1));
    return normal;
}

float3 SampleNormal(float2 uv)
{
    return SAMPLE_TEXTURE2D_LOD(_NormalMap, _LinearClampSampler, uv, 0).rgb * 2.0 - 1.0;
}

float SampleHeight(float2 uv)
{
    return UnpackHeightmap(SAMPLE_TEXTURE2D_LOD(_HeightMap, _LinearClampSampler, uv, 0).x);
}

// --- TerrainFillKernel ---

#pragma kernel FillTerrain
#pragma multi_compile_local _ HAS_LAYER_MASK
#pragma multi_compile_local _ COMPUTE_NORMALS

[numthreads(THREADS_PER_GROUP, 1, 1)]
void FillTerrain(uint3 groupID : SV_GroupID, uint groupThreadIndex : SV_GroupIndex)
{
    uint instanceID = UnwrapLinearDispatchThreadID(groupID, groupThreadIndex, THREADS_PER_GROUP);
    if (instanceID >= _DesiredCount)
        return;

    float2 uvMin = _CellMinMax.xy / _TerrainSize.xz;
    float2 uvMax = _CellMinMax.zw / _TerrainSize.xz;
    float2 uvRnd = float2(Halton(_HaltonBaseIndex + instanceID, 2), Halton(_HaltonBaseIndex + instanceID, 3));
    float2 uv = uvMin + uvRnd * (uvMax - uvMin);

    float height = SampleHeight(uv);
    float3 localPosition = 0;
    localPosition.xz = uv * _TerrainSize.xz;
    localPosition.y  = height * 2.0 * _TerrainSize.y;

    float3 worldPosition = _TerrainPosition.xyz + localPosition;
    float verticalOffset = lerp(_VerticalOffsetMinMax.x, _VerticalOffsetMinMax.y, Halton(_HaltonBaseIndex + instanceID, 19));
    worldPosition.y += verticalOffset;

    float3 worldNormal;
#if COMPUTE_NORMALS
    worldNormal = CalculateNormal(uv);
#else
    worldNormal = SampleNormal(uv);
#endif

    bool validPlacement = IsValidPlacement(worldPosition, worldNormal);

    UNITY_BRANCH
    if (validPlacement)
    {
        LocalTransform instance;
        instance.Position = worldPosition;
        instance.Rotation = ComputeRotation(worldNormal, instanceID);
        instance.Scale = ComputeScale(instanceID);
        _TransformsBuffer.Append(instance);
    }
}
