// #pragma enable_d3d11_debug_symbols

#define THREADS_PER_GROUP (64)

#include "Packages/com.ma.flora/ShaderLibrary/ComputeUtility.hlsl"

#pragma multi_compile_local TYPE_FLOAT4 TYPE_FLOAT TYPE_RAW TYPE_RAW4

#if defined(TYPE_RAW) || defined(TYPE_RAW4)
ByteAddressBuffer _SrcBuffer;
RWByteAddressBuffer _DstBuffer;
ByteAddressBuffer _ScatterBuffer;
ByteAddressBuffer _UploadBuffer;
#else
StructuredBuffer<float4> _SrcBuffer;
RWStructuredBuffer<float4> _DstBuffer;
StructuredBuffer<uint> _ScatterBuffer;
StructuredBuffer<float4> _UploadBuffer;
#endif

uint _Size;         // Size of the operation
uint _Value;        // Value to be set in the destination buffer
uint _SrcOffset;    // Offset into the source buffer where the operation will start
uint _DstOffset;    // Offset into the destination buffer where the operation will start
uint _ScatterCount; // Number of scatter operations to perform

//-----------------------------------------------------------------------------
// Memset
//-----------------------------------------------------------------------------

#pragma kernel MemsetCS

[numthreads(THREADS_PER_GROUP, 1, 1)]
void MemsetCS(uint3 groupId : SV_GroupID, uint groupThreadIndex : SV_GroupIndex)
{
    uint dispatchThreadID = UnwrapLinearDispatchThreadID(groupId, groupThreadIndex, THREADS_PER_GROUP);
#if defined(TYPE_FLOAT4)
    if (dispatchThreadID < _Size)
    {
        _DstBuffer[_DstOffset + dispatchThreadID] = asfloat(_Value);
    }
#elif defined(TYPE_RAW) || defined(TYPE_RAW4)
    uint dstIndex = _DstOffset + dispatchThreadID * 4;

    if (dispatchThreadID * 4 + 3 < _Size)
    {
        _DstBuffer.Store4(dstIndex * 4, uint4(_Value, _Value, _Value, _Value));
    }
    else if (dispatchThreadID * 4 + 2 < _Size)
    {
        _DstBuffer.Store3(dstIndex * 4, uint3(_Value, _Value, _Value));
    }
    else if (dispatchThreadID * 4 + 1 < _Size)
    {
        _DstBuffer.Store2(dstIndex * 4, uint2(_Value, _Value));
    }
    else if (dispatchThreadID * 4 < _Size)
    {
        _DstBuffer.Store(dstIndex * 4, _Value);
    }
#endif
}

//-----------------------------------------------------------------------------
// Memcpy
//-----------------------------------------------------------------------------

#pragma kernel MemcpyCS

[numthreads(THREADS_PER_GROUP, 1, 1)]
void MemcpyCS(uint3 groupId : SV_GroupID, uint groupThreadIndex : SV_GroupIndex)
{
    uint dispatchThreadID = UnwrapLinearDispatchThreadID(groupId, groupThreadIndex, THREADS_PER_GROUP);
#if defined(TYPE_FLOAT4)
    if (dispatchThreadID < _Size)
    {
        _DstBuffer[_DstOffset + dispatchThreadID] = _SrcBuffer[_SrcOffset + dispatchThreadID];
    }
#elif defined(TYPE_RAW) || defined(TYPE_RAW4)
    uint srcIndex = _SrcOffset + dispatchThreadID * 4;
    uint dstIndex = _DstOffset + dispatchThreadID * 4;

    if (dispatchThreadID * 4 + 3 < _Size)
    {
        uint4 srcData = _SrcBuffer.Load4(srcIndex * 4);
        _DstBuffer.Store4(dstIndex * 4, srcData);
    }
    else if (dispatchThreadID * 4 + 2 < _Size)
    {
        uint3 srcData = _SrcBuffer.Load3(srcIndex * 4);
        _DstBuffer.Store3(dstIndex * 4, srcData);
    }
    else if (dispatchThreadID * 4 + 1 < _Size)
    {
        uint2 srcData = _SrcBuffer.Load2(srcIndex * 4);
        _DstBuffer.Store2(dstIndex * 4, srcData);
    }
    else if (dispatchThreadID * 4 < _Size)
    {
        uint srcData = _SrcBuffer.Load(srcIndex * 4);
        _DstBuffer.Store(dstIndex * 4, srcData);
    }
#endif
}

//-----------------------------------------------------------------------------
// Scatter
//-----------------------------------------------------------------------------

#pragma kernel ScatterCS

[numthreads(THREADS_PER_GROUP, 1, 1)]
void ScatterCS(uint3 groupId : SV_GroupID, uint groupThreadIndex : SV_GroupIndex)
{
    uint dispatchThreadID = UnwrapLinearDispatchThreadID(groupId, groupThreadIndex, THREADS_PER_GROUP);
    uint linearIndex = dispatchThreadID + _SrcOffset;
    uint scatterIndex = linearIndex / _Size;
    uint scatterOffset = linearIndex - scatterIndex * _Size;

    if (scatterIndex < _ScatterCount)
    {
#if defined(TYPE_FLOAT)
        uint srcIndex = linearIndex;
        uint dstIndex = _ScatterBuffer[scatterIndex] * _Size + scatterOffset;
        uint srcFloat4Index   = srcIndex / 4;
        uint srcFloat4Channel = srcIndex & 3;
        uint dstFloat4Index   = dstIndex / 4;
        uint dstFloat4Channel = dstIndex & 3;
        _DstBuffer[dstFloat4Index][dstFloat4Channel] = _UploadBuffer[srcFloat4Index][srcFloat4Channel];
#elif defined(TYPE_FLOAT2)
        // TODO:
#elif defined(TYPE_FLOAT4)
        uint dstIndex = _ScatterBuffer[scatterIndex] * _Size + scatterOffset;
        uint srcIndex = linearIndex;
        _DstBuffer[dstIndex] = _UploadBuffer[srcIndex];
#elif defined(TYPE_RAW)
        uint dstIndex = _ScatterBuffer.Load(scatterIndex * 4) * _Size + scatterOffset;
        uint srcIndex = linearIndex;
        uint srcData = _UploadBuffer.Load(srcIndex * 4);
        _DstBuffer.Store(dstIndex * 4, srcData);
#elif defined(TYPE_RAW4)
        uint dstIndex = _ScatterBuffer.Load(scatterIndex * 4) * _Size + scatterOffset;
        uint srcIndex = linearIndex;
        uint4 srcData = _UploadBuffer.Load4(srcIndex * 16);
        _DstBuffer.Store4(dstIndex * 16, srcData);
#endif
    }
}
