#define THREADS_PER_GROUP (64)

#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"
#include "Packages/com.ma.flora/Runtime/Rendering/Occlusion/OcclusionCulling.hlsl"
#include "Packages/com.ma.flora/Runtime/Rendering/DrawBatcher.hlsl"
#include "Packages/com.ma.flora/ShaderLibrary/InstancedData.hlsl"

// #pragma enable_d3d11_debug_symbols

#pragma multi_compile_local _ USE_DENSITY

#pragma multi_compile_local _ USE_OCCLUSION
#pragma multi_compile_local _ OCCLUSION_DEBUG

#pragma multi_compile_local _ DEBUG_COUNTERS
#pragma multi_compile_local _ EDITOR_SELECTION_ONLY

#define INDIRECT_ARGS_UINT_COUNT     (5u)
#define INDIRECT_ARGS_INSTANCE_COUNT (1u)

#define PAYLOAD_INDEX_MASK           (0xFFFFu)
#define PAYLOAD_DRAW_INDEX_SHIFT     (16u)

#define DEBUG_COUNTER_TYPE_VISIBLE   (0u)
#define DEBUG_COUNTER_TYPE_CULLED    (1u)
#define DEBUG_COUNTER_TYPE_OCCLUDED  (2u)
#define DEBUG_COUNTER_TYPE_COUNT     (3u)

#define CULL_FLAG_DENSITY            (0x1u)
#define CULL_FLAG_CROSS_FADE         (0x2u)
#define CULL_FLAG_CROSS_FADE_PERC    (0x4u)
#define CULL_FLAG_CROSS_FADE_ANIM    (0x8u)
#define CULL_FLAG_OCCLUSION          (0x10u)

//-----------------------------------------------------------------------------
// Utils
//-----------------------------------------------------------------------------

// Note: Avoids zero in the result
int PackInstanceCrossFadeSnorm8(float value)
{
    uint packed = uint((1.0 + value) * 127.0 + 0.5);
    uint lowerBound = value < 0.0 ? 0   : 128;
    uint upperBound = value < 0.0 ? 126 : 254;
    packed = clamp(packed, lowerBound, upperBound);
    return int(packed) - 127;
}

//-----------------------------------------------------------------------------
// Uniforms
//-----------------------------------------------------------------------------

struct IndirectBatchPayload
{
    float CullDistance;
    float3 LODCoefficients;
    float4 LODDistances;
};

struct IndirectDrawInfo
{
    uint IndexCountPerInstance;
    uint InstanceCount;
    uint StartIndex;
    uint BaseVertexIndex;
    uint IndirectStartIndex;
    uint CullFlags;
};

CBUFFER_START(BuildInstanceDrawsVariables)
    float4 _CameraPosition;         // Camera position in world space
    float4 _CameraAnimPositionPrev; // Animated camera position in world space from the previous frame
    float4 _CameraAnimPositionCurr; // Animated camera position in world space from the current frame
    uint   _BatchStart;             // The offset into the batch buffer
    uint   _BatchCount;             // The number of batches to process
    uint   _DebugCounterIndex;      // The index into the debug counter buffer
    uint   _IndirectDrawCount;      // The number of indirect draw infos
CBUFFER_END

StructuredBuffer<IndirectBatchPayload> _IndirectBatchPayloads;        // Batch payloads
StructuredBuffer<IndirectDrawInfo>     _IndirectDrawInfos;            // Indirect draw infos
RWBuffer<uint>                         _IndirectDrawArgsRW;           // Output draw indirect args
RWByteAddressBuffer                    _IndirectInstanceVisibilityRW; // Output visible instances
#if defined(DEBUG_COUNTERS)
RWStructuredBuffer<uint>               _DebugCounterBufferRW;         // Output debug counters
#endif

//-----------------------------------------------------------------------------
// Reset Indirect Draw Args
//-----------------------------------------------------------------------------

#pragma kernel ResetIndirectDrawArgs

[numthreads(THREADS_PER_GROUP, 1, 1)]
void ResetIndirectDrawArgs(WrappedGroup group)
{
    uint indirectDrawIndex = UnwrapLinearDispatchThreadID(group, THREADS_PER_GROUP);
    if (indirectDrawIndex < _IndirectDrawCount)
    {
        IndirectDrawInfo drawInfo = _IndirectDrawInfos[indirectDrawIndex];
        uint drawArgsBaseIndex = indirectDrawIndex * INDIRECT_ARGS_UINT_COUNT;

        _IndirectDrawArgsRW[drawArgsBaseIndex + 0] = drawInfo.IndexCountPerInstance;
        _IndirectDrawArgsRW[drawArgsBaseIndex + 1] = 0;
        _IndirectDrawArgsRW[drawArgsBaseIndex + 2] = drawInfo.StartIndex;
        _IndirectDrawArgsRW[drawArgsBaseIndex + 3] = drawInfo.BaseVertexIndex;
        _IndirectDrawArgsRW[drawArgsBaseIndex + 4] = drawInfo.IndirectStartIndex;
    }
}

//-----------------------------------------------------------------------------
// Build Instance Draws
//-----------------------------------------------------------------------------

#pragma kernel BuildInstanceDraws

[numthreads(THREADS_PER_GROUP, 1, 1)]
void BuildInstanceDraws(WrappedGroup group)
{
    InstanceBatchTask task = (InstanceBatchTask)0;
    SetupInstanceBatchTask(_BatchStart, _BatchCount, group.GroupID, group.GroupIndex, task);
    if (!task.IsValid)
        return;

    uint instanceIndex = task.Item.InstanceDataOffset + uint(task.Index);

    SampleFloraInstance(instanceIndex);
    SampledFloraInstance instance = GetSampledFloraInstance();
    SampledFloraInstanceRenderer renderer = GetSampledFloraInstanceRenderer();

    uint payloadIndex = task.Item.Payload & PAYLOAD_INDEX_MASK;
    uint indirectDrawIndex = task.Item.Payload >> PAYLOAD_DRAW_INDEX_SHIFT;
    IndirectBatchPayload payload = _IndirectBatchPayloads[payloadIndex];
    IndirectDrawInfo drawInfo = _IndirectDrawInfos[indirectDrawIndex];

    float3 objectCenter = instance.Center.xyz;
    float screenRelativeMetricSq = _CameraPosition.w;
    float cullDistance = payload.CullDistance;
    float cameraDistToLODCenter = sqrt(Length2(objectCenter - _CameraPosition.xyz) * screenRelativeMetricSq);
    bool visible = cameraDistToLODCenter < cullDistance;

#if defined(EDITOR_SELECTION_ONLY)
    visible = visible && LoadFloraInstancedData_IsSelected();
#endif

#if defined(USE_DENSITY)
    UNITY_BRANCH
    if (visible && (drawInfo.CullFlags & CULL_FLAG_DENSITY))
    {
        float density = renderer.DynamicDensityParams.x;
        float densityMin = renderer.DynamicDensityParams.y * cullDistance;
        float densityMax = renderer.DynamicDensityParams.z * cullDistance;
        float falloffExponent = renderer.DynamicDensityParams.w;

        if (cameraDistToLODCenter > densityMin)
        {
            float invRange = 1.0 / (densityMax - densityMin);
            float distanceFactor = (cameraDistToLODCenter - densityMin) * invRange;
            float falloffFactor = exp(-falloffExponent * distanceFactor);
            float visibilityProbability = lerp(density, 1.0, falloffFactor);
            visible = (instance.RandomID < visibilityProbability);
        }
    }
#endif

    bool occluded = false;
#if defined(USE_OCCLUSION)
    UNITY_BRANCH
    if (visible)
    {
        // // early out if none of these culling splits are visible
        // // TODO: plumb through other state per draw command to filter here?
        // if ((splitMask & _CullingSplitMask) == 0)
        //     return;

        SphereBound bound;
        bound.Center = instance.Center;
        bound.Radius = instance.Radius;

        bool isOccludedInAll = true;
        for (int testIndex = 0; testIndex < _OcclusionTestCount; ++testIndex)
        {
            // unpack the culling split index and subview index for this test
            int splitIndex = (_CullingSplitIndices >> (4 * testIndex)) & 0xf;
            int subviewIndex = (_OccluderSubviewIndices >> (4 * testIndex)) & 0xf;

            // // skip if this draw call is not present in this split index
            // if (((1 << splitIndex) & splitMask) == 0)
            //     continue;

            // occlusion test against the corresponding subview
            if (IsOcclusionVisible(bound, subviewIndex))
                isOccludedInAll = false;
        }

        occluded = !isOccludedInAll;
    }
#endif

#if defined(DEBUG_COUNTERS)
    uint counterIndex = occluded ? DEBUG_COUNTER_TYPE_OCCLUDED : (visible ? DEBUG_COUNTER_TYPE_VISIBLE : DEBUG_COUNTER_TYPE_CULLED);
    uint resultUnused = 0;
    InterlockedAdd(_DebugCounterBufferRW[_DebugCounterIndex*DEBUG_COUNTER_TYPE_COUNT + counterIndex], 1u, resultUnused);
#endif

    int packedCrossFade = 127;

    UNITY_BRANCH
    if (visible && (drawInfo.CullFlags & CULL_FLAG_CROSS_FADE))
    {
        float ditherFactor = 1.0;

        UNITY_BRANCH
        if (drawInfo.CullFlags & CULL_FLAG_CROSS_FADE_ANIM)
        {
            float dist0 = sqrt(Length2(objectCenter - _CameraAnimPositionPrev.xyz) * screenRelativeMetricSq);
            float dist1 = sqrt(Length2(objectCenter - _CameraAnimPositionCurr.xyz) * screenRelativeMetricSq);
            float3 cmp0 = float3(dist0.xxx > float3(FLT_MIN, payload.LODDistances.xy));
            float3 cmp1 = float3(dist1.xxx > float3(FLT_MIN, payload.LODDistances.xy));
            float fade0 = dot(cmp0, payload.LODCoefficients.xyz) * _CameraAnimPositionPrev.w; // [1, 0]
            float fade1 = dot(cmp1, payload.LODCoefficients.xyz) * _CameraAnimPositionCurr.w; // [0, 1]
            float ratio = fade0 + fade1;
            visible = abs(ratio) < 0.999;
            ditherFactor = ratio < 0.0 ? ratio : 1.0 - ratio;
        }
        else if (drawInfo.CullFlags & CULL_FLAG_CROSS_FADE_PERC)
        {
            float minDist = payload.LODDistances.x;
            float maxDist = payload.LODDistances.y;
            ditherFactor = max((cameraDistToLODCenter - minDist), 0.0) / (maxDist - minDist);
            visible = cameraDistToLODCenter >= minDist && cameraDistToLODCenter <= maxDist;
        }
        else
        {
            float lod0TransitionStartDist = payload.LODDistances.x;
            float lod0TransitionEndDist = payload.LODDistances.y;
            float lod1TransitionStartDist = payload.LODDistances.z;
            float lod1TransitionEndDist = payload.LODDistances.w;

            UNITY_BRANCH
            if (cameraDistToLODCenter < lod0TransitionStartDist || cameraDistToLODCenter > lod1TransitionEndDist)
            {
                // Outside the LOD range
                ditherFactor = 0.0;
                visible = false;
            }
            else if (cameraDistToLODCenter <= lod0TransitionEndDist)
            {
                // Transitioning in to the current LOD
                float transitionLength = lod0TransitionEndDist - lod0TransitionStartDist;
                float diff = lod0TransitionEndDist - cameraDistToLODCenter;
                ditherFactor = -(diff / transitionLength);
            }
            else if (cameraDistToLODCenter <= lod1TransitionEndDist)
            {
                // Transitioning out to the next LOD
                float transitionLength = lod1TransitionEndDist - lod1TransitionStartDist;
                float diff = lod1TransitionEndDist - cameraDistToLODCenter;
                ditherFactor = (diff / transitionLength);
            }
        }

        packedCrossFade = PackInstanceCrossFadeSnorm8(ditherFactor);
    }

    UNITY_BRANCH
    if (visible)
    {
        uint indirectArgsOffset_InstanceCount = (indirectDrawIndex * INDIRECT_ARGS_UINT_COUNT) + INDIRECT_ARGS_INSTANCE_COUNT;
        uint offsetInDraw;
        InterlockedAdd(_IndirectDrawArgsRW[indirectArgsOffset_InstanceCount], 1u, offsetInDraw);

        uint writeIndex = drawInfo.IndirectStartIndex + offsetInDraw;
        _IndirectInstanceVisibilityRW.Store(writeIndex << 2, packedCrossFade << 24u | instanceIndex);
    }
}
