  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041E\u0441\u043D\u043E\u0432\u043D\u044B\u0435 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438:\r\n
    \u2022 \u0414\u043B\u0438\u043D\u043E\u0439 \u043E\u043A\u043E\u043B\u043E 10
    \u043C\u0435\u0442\u0440\u043E\u0432 \u0438 \u043C\u0430\u0441\u0441\u043E\u0439
    \u043E\u043A\u043E\u043B\u043E 3\u20145 \u0442\u043E\u043D\u043D.\r\n \u2022
    \u0422\u0435\u043B\u043E \u0431\u044B\u043B\u043E \u043F\u043E\u043A\u0440\u044B\u0442\u043E
    \u043A\u043E\u0436\u0435\u0439, \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E,
    \u0438\u043C\u0435\u043B\u0438 \u043F\u0440\u0438\u043C\u0438\u0442\u0438\u0432\u043D\u044B\u0435
    \u043F\u0435\u0440\u044C\u0435\u0432\u0438\u0434\u043D\u044B\u0435 \u0441\u0442\u0440\u0443\u043A\u0442\u0443\u0440\u044B.\r\n
    \u2022 \u041D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u043F\u043E\u043B\u0443\u0447\u0438\u043B
    \u0438\u0437-\u0437\u0430 \u0441\u0445\u043E\u0434\u0441\u0442\u0432\u0430 \u0437\u0443\u0431\u043E\u0432
    \u0441 \u0437\u0443\u0431\u0430\u043C\u0438 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u0445
    \u0438\u0433\u0443\u0430\u043D.\r\n \u2022 \u041F\u0435\u0440\u0435\u0434\u0432\u0438\u0433\u0430\u043B\u0441\u044F
    \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E
    \u043D\u0430 \u0434\u0432\u0443\u0445 \u0437\u0430\u0434\u043D\u0438\u0445 \u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0441\u0442\u044F\u0445,
    \u0445\u043E\u0442\u044F \u043C\u043E\u0433 \u043E\u043F\u0443\u0441\u043A\u0430\u0442\u044C\u0441\u044F
    \u043D\u0430 \u0447\u0435\u0442\u044B\u0440\u0435 \u043D\u043E\u0433\u0438.\r\n
    \u2022 \u0425\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043D\u0430 \u043A\u0440\u0443\u043F\u043D\u0430\u044F
    \u043B\u0430\u0434\u043E\u043D\u044C \u0441 \u0431\u043E\u043B\u044C\u0448\u0438\u043C
    \u043F\u0430\u043B\u044C\u0446\u0435\u043C-\u043A\u043B\u044B\u043A\u043E\u043C,
    \u0432\u0435\u0440\u043E\u044F\u0442\u043D\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0432\u0448\u0438\u043C\u0441\u044F
    \u0434\u043B\u044F \u043E\u0431\u043E\u0440\u043E\u043D\u044B \u0438\u043B\u0438
    \u0443\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u044F \u043F\u0438\u0449\u0438."
