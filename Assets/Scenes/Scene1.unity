  m_text: "\t\u0410\u0440\u0433\u0435\u043D\u0442\u0438\u043D\u043E\u0437\u0430\u0432\u0440
    (Argentinosaurus) \u2014 \u0433\u0438\u0433\u0430\u043D\u0442\u0441\u043A\u0438\u0439
    \u0442\u0440\u0430\u0432\u043E\u044F\u0434\u043D\u044B\u0439 \u0434\u0438\u043D\u043E\u0437\u0430\u0432\u0440,
    \u043F\u0440\u0438\u043D\u0430\u0434\u043B\u0435\u0436\u0430\u0449\u0438\u0439
    \u043A \u0433\u0440\u0443\u043F\u043F\u0435 \u0442\u0438\u0442\u0430\u043D\u043E\u0437\u0430\u0432\u0440\u043E\u0432,
    \u043E\u0431\u0438\u0442\u0430\u0432\u0448\u0438\u0439 \u0432 \u042E\u0436\u043D\u043E\u0439
    \u0410\u043C\u0435\u0440\u0438\u043A\u0435 \u0432 \u043C\u0435\u043B\u043E\u0432\u043E\u043C
    \u043F\u0435\u0440\u0438\u043E\u0434\u0435 \u043E\u043A\u043E\u043B\u043E 97\u201494
    \u043C\u0438\u043B\u043B\u0438\u043E\u043D\u043E\u0432 \u043B\u0435\u0442 \u043D\u0430\u0437\u0430\u0434.\r"
