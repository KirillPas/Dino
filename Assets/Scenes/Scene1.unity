      m_Calls: []
  m_text: "\t\u0411\u0430\u0440\u0438\u043E\u043D\u0438\u043A\u0441 (Baryonyx) \u2014
    \u0440\u043E\u0434 \u043F\u043B\u043E\u0442\u043E\u044F\u0434\u043D\u044B\u0445
    \u0434\u0438\u043D\u043E\u0437\u0430\u0432\u0440\u043E\u0432-\u0442\u0435\u0440\u043E\u043F\u043E\u0434,
    \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439 \u0441\u0432\u043E\u0438\u043C
    \u043D\u0435\u043E\u0431\u044B\u0447\u043D\u044B\u043C \u0441\u0442\u0440\u043E\u0435\u043D\u0438\u0435\u043C
    \u0441\u0440\u0435\u0434\u0438 \u0441\u043F\u0438\u043D\u043E\u0437\u0430\u0432\u0440\u0438\u0434.
    \u0416\u0438\u043B\u0438 \u0432 \u0415\u0432\u0440\u043E\u043F\u0435 \u0432 \u0440\u0430\u043D\u043D\u0435\u043C
    \u043C\u0435\u043B\u043E\u0432\u043E\u043C \u043F\u0435\u0440\u0438\u043E\u0434\u0435
    \u043E\u043A\u043E\u043B\u043E 130\u2014125 \u043C\u0438\u043B\u043B\u0438\u043E\u043D\u043E\u0432
    \u043B\u0435\u0442 \u043D\u0430\u0437\u0430\u0434."
