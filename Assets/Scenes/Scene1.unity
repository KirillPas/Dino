  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041E\u0441\u043D\u043E\u0432\u043D\u044B\u0435 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438:\r\n
    \u2022 \u0420\u0430\u0437\u043C\u0435\u0440\u044B \u0432\u0430\u0440\u044C\u0438\u0440\u043E\u0432\u0430\u043B\u0438\u0441\u044C
    \u043E\u0442 7 \u0434\u043E 10 \u043C\u0435\u0442\u0440\u043E\u0432 \u0432 \u0434\u043B\u0438\u043D\u0443
    \u0438 \u0432\u0435\u0441\u043E\u043C \u043E\u043A\u043E\u043B\u043E 1,2\u20142
    \u0442\u043E\u043D\u043D.\r\n \u2022 \u041F\u043E\u043B\u0443\u0447\u0438\u043B
    \u043D\u0430\u0437\u0432\u0430\u043D\u0438\u0435 \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F
    \u043E\u0433\u0440\u043E\u043C\u043D\u043E\u043C\u0443 \u043A\u043E\u0433\u0442\u044E
    \u043D\u0430 \u0431\u043E\u043B\u044C\u0448\u043E\u043C \u043F\u0430\u043B\u044C\u0446\u0435
    \u043F\u0435\u0440\u0435\u0434\u043D\u0438\u0445 \u043A\u043E\u043D\u0435\u0447\u043D\u043E\u0441\u0442\u0435\u0439
    (\xABbarys\xBB \u043E\u0437\u043D\u0430\u0447\u0430\u0435\u0442 \u0442\u044F\u0436\u0451\u043B\u044B\u0439,
    \xABonychos\xBB \u2014 \u043A\u043E\u0433\u043E\u0442\u044C).\r\n \u2022 \u0418\u043C\u0435\u043B
    \u0443\u0437\u043A\u0443\u044E \u043C\u043E\u0440\u0434\u0443, \u043F\u043E\u0445\u043E\u0436\u0443\u044E
    \u043D\u0430 \u043A\u0440\u043E\u043A\u043E\u0434\u0438\u043B\u044C\u044E, \u0438
    \u0440\u044F\u0434 \u043E\u0441\u0442\u0440\u044B\u0445 \u0437\u0430\u0437\u0443\u0431\u0440\u0435\u043D\u043D\u044B\u0445
    \u0437\u0443\u0431\u043E\u0432, \u043F\u0440\u0438\u0441\u043F\u043E\u0441\u043E\u0431\u043B\u0435\u043D\u043D\u044B\u0445
    \u0434\u043B\u044F \u0437\u0430\u0445\u0432\u0430\u0442\u0430 \u0440\u044B\u0431\u044B.\r\n
    \u2022 \u041F\u0440\u0435\u0434\u043F\u043E\u043B\u0430\u0433\u0430\u0435\u0442\u0441\u044F,
    \u0447\u0442\u043E \u0431\u0430\u0440\u0438\u043E\u043D\u0438\u043A\u0441 \u0432\u0435\u043B
    \u043F\u043E\u043B\u0443\u0432\u043E\u0434\u043D\u044B\u0439 \u043E\u0431\u0440\u0430\u0437
    \u0436\u0438\u0437\u043D\u0438, \u043E\u0445\u043E\u0442\u0438\u043B\u0441\u044F
    \u0433\u043B\u0430\u0432\u043D\u044B\u043C \u043E\u0431\u0440\u0430\u0437\u043E\u043C
    \u043D\u0430 \u0440\u044B\u0431\u0443, \u0445\u043E\u0442\u044F \u0438\u043D\u043E\u0433\u0434\u0430
    \u043F\u043E\u0435\u0434\u0430\u043B \u043C\u0435\u043B\u043A\u0438\u0445 \u0441\u0443\u0445\u043E\u043F\u0443\u0442\u043D\u044B\u0445
    \u0436\u0438\u0432\u043E\u0442\u043D\u044B\u0445 \u0421\u043E\u0432\u0435\u0442\u0443\u044E
    \u0431\u044B\u0442\u044C \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u0435\u0435!!!"
