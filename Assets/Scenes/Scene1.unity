  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041E\u0441\u043D\u043E\u0432\u043D\u044B\u0435 \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438:\r\n
    \u2022 \u0414\u043B\u0438\u043D\u0430 \u0442\u0435\u043B\u0430 \u0441\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u043B\u0430
    \u043F\u0440\u0438\u043C\u0435\u0440\u043D\u043E 4,5\u20145 \u043C\u0435\u0442\u0440\u043E\u0432.\r\n
    \u2022 \u0412\u0435\u0441\u0438\u043B \u043E\u043A\u043E\u043B\u043E 1 \u0442\u043E\u043D\u043D\u044B.\r\n
    \u2022 \u041E\u0442\u043B\u0438\u0447\u0430\u043B\u0441\u044F \u043D\u0430\u043B\u0438\u0447\u0438\u0435\u043C
    \u0440\u044F\u0434\u0430 \u0448\u0438\u043F\u043E\u0432 \u0432\u0434\u043E\u043B\u044C
    \u0441\u043F\u0438\u043D\u044B \u0438 \u0445\u0432\u043E\u0441\u0442\u0430, \u0430
    \u0442\u0430\u043A\u0436\u0435 \u043F\u0430\u0440\u043E\u0439 \u043A\u0440\u0443\u043F\u043D\u044B\u0445
    \u0448\u0438\u043F\u043E\u0432 \u043D\u0430\u0434 \u0431\u0435\u0434\u0440\u0430\u043C\u0438.\r\n
    \u2022 \u0415\u0433\u043E \u0440\u0430\u0446\u0438\u043E\u043D \u0441\u043E\u0441\u0442\u043E\u044F\u043B
    \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E
    \u0438\u0437 \u043D\u0438\u0437\u043A\u043E\u0440\u043E\u0441\u043B\u043E\u0439
    \u0440\u0430\u0441\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438.\r"
