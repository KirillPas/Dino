      m_Calls: []
  m_text: "\t\u0418\u0433\u0443\u0430\u043D\u043E\u0434\u043E\u043D\u0442 (Iguanodon)
    \u2014 \u043A\u0440\u0443\u043F\u043D\u044B\u0439 \u0442\u0440\u0430\u0432\u043E\u044F\u0434\u043D\u044B\u0439
    \u0434\u0438\u043D\u043E\u0437\u0430\u0432\u0440, \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u0438\u0442\u0435\u043B\u044C
    \u043E\u0442\u0440\u044F\u0434\u0430 \u043E\u0440\u043D\u0438\u0442\u043E\u043F\u043E\u0434,
    \u0436\u0438\u0432\u0448\u0438\u0439 \u0432 \u0440\u0430\u043D\u043D\u0435\u043C
    \u043C\u0435\u043B\u043E\u0432\u043E\u043C \u043F\u0435\u0440\u0438\u043E\u0434\u0435
    \u043E\u043A\u043E\u043B\u043E 130\u2014120 \u043C\u0438\u043B\u043B\u0438\u043E\u043D\u043E\u0432
    \u043B\u0435\u0442 \u043D\u0430\u0437\u0430\u0434."
