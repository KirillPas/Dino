  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\t\u0412\u044B \u0438\u0433\u0440\u0430\u0435\u0442\u0435 \u0437\u0430
    \u0421\u0442\u0435\u0433\u043E\u0437\u0430\u0432\u0440\u0430. \u0421\u0442\u0435\u0433\u043E\u0437\u0430\u0432\u0440
    (Stegosaurus) \u2014 \u0440\u043E\u0434 \u0442\u0440\u0430\u0432\u043E\u044F\u0434\u043D\u044B\u0445
    \u0434\u0438\u043D\u043E\u0437\u0430\u0432\u0440\u043E\u0432, \u043E\u0442\u043D\u043E\u0441\u044F\u0449\u0438\u0445\u0441\u044F
    \u043A \u0441\u0435\u043C\u0435\u0439\u0441\u0442\u0432\u0443 \u0441\u0442\u0435\u0433\u043E\u0437\u0430\u0432\u0440\u0438\u0434,
    \u0436\u0438\u0432\u0448\u0438\u0445 \u0432 \u044E\u0440\u0441\u043A\u043E\u043C
    \u043F\u0435\u0440\u0438\u043E\u0434\u0435 \u043E\u043A\u043E\u043B\u043E 155\u2014150
    \u043C\u0438\u043B\u043B\u0438\u043E\u043D\u043E\u0432 \u043B\u0435\u0442 \u043D\u0430\u0437\u0430\u0434.
    \u0418\u0445 \u043E\u043A\u0430\u043C\u0435\u043D\u0435\u043B\u043E\u0441\u0442\u0438
    \u043D\u0430\u0439\u0434\u0435\u043D\u044B \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E
    \u043D\u0430 \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438 \u0441\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E\u0439
    \u0437\u0430\u043F\u0430\u0434\u043D\u043E\u0439 \u0447\u0430\u0441\u0442\u0438
    \u0421\u0435\u0432\u0435\u0440\u043D\u043E\u0439 \u0410\u043C\u0435\u0440\u0438\u043A\u0438."
